{
	"extends": "astro/tsconfigs/strictest",
	"include": [
		".astro/types.d.ts",
		"**/*"
	],
	"exclude": [
		"dist"
	],
	"compilerOptions": {
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@c/*": [
				"./src/components/*"
			],
			"@l/*": [
				"./src/layouts/*"
			],
			"@s/*": [
				"./src/styles/*"
			],
			"@v/*": [
				"./src/views/*"
			],
			"@i18n/*": [
				"./src/i18n/*"
			]
		},
		"jsx": "react-jsx",
		"jsxImportSource": "react"
	}
}
