---
import "./ProfileCard.css";

interface Props {
	image?: ImageMetadata;
	name: string;
	subtitle: string;
	orientation: "vertical" | "horizontal";
}

const { image, name, subtitle, orientation } = Astro.props;
---

<div class:list={["profile-card", `profile-card-orientation-${orientation}`]}>
	<div class="profile-card-image-container">
		{image ? <img src={image?.src} alt={name} class="profile-card-image" width="80px" height="80px" /> : null}
	</div>
	<div class="profile-card-contents-container">
		<div class="profile-card-name">{name}</div>
		<div class="profile-card-subtitle">{subtitle}</div>
		<div class="profile-card-contents">
			<slot />
		</div>
	</div>
</div>
