---
import "@css/index.css";
import ProfilePic from "@img/profile.jpg";
import { LocaleCodes } from "@src/globals";

import Basic from "@l/Basic.astro";
import Heading from "@c/Heading.tsx";
import OptionsMenu from "@c/UIOptionsMenu";
import ProfileCard from "@c/ProfileCard.astro";

const PageName = "Home";
---

<Basic lang={LocaleCodes.ID} PageName={PageName}>
	<OptionsMenu
		themeToggleText="Ganti tema"
		themeRandomText="Acak warna tema"
		client:only="preact"
	/>
	<main class:list={["hero"]}>
		<Heading level={1} class="hero-heading emphasis">Halo</Heading>
		<div class:list={["hero-content"]}>
			<p>Sedang dalam pembangunan, mohon cek kembali nanti.</p>
		</div>
		<ul class:list={["hero-links"]}>
			<li><a href="https://github.com/mirzattar">github</a></li>
		</ul>
	</main>
	<section class="about-me">
		<Heading level={2} class="about-me-heading">Tentang saya</Heading>
		<div class="about-me-container">
			<div class="about-me-profile">
				<ProfileCard
					image={ProfilePic}
					name="Mirza Attar Fauzie"
					subtitle="mahasiswa"
					orientation="vertical"
				/>
			</div>
			<div class="about-me-bio">
				<p>
					Hai, namaku Mirza Attar Fauzie, Anda bisa memanggilku Attar.
				</p>
				<p>
					Saya seorang calon software engineer (amin) yang sekarang duduk di
					bangku Universitas Indonesia.
				</p>
				<p>
					Saya umumnya berkecimpung dalam front-end web development,
					dengan kesukaan tersendiri dengan bahasa CSS dan
					JavaScript/TypeScript. Di antara yang lain, spesialisasi
					saya adalah:
				</p>
				<ul>
					<li>Menulis untuk codebase dan lingkungan tua.</li>
					<li>
						Berkolaborasi dalam komunitas dan pengembangan
						proyek-proyek open-source.
					</li>
					<li>
						Mengembangkan sistem dengan paradigma, metode, dan
						teknologi baru (Saya sangat menyukai mempelajari hal
						baru!).
					</li>
					<li>
						Bercakap dalam bahasa Inggris dan Bahasa Indonesia
						dengan fasih.
					</li>
					<li>
						Menjalankan dan mengatur cloud deployment, peladen,
						perangkat lunak otonom, dan pipeline CI/CD.
					</li>
					<li>sy pakai arch, btw.</li>
				</ul>
			</div>
		</div>
	</section>
	<section class="projects">
		<Heading level={2} class="projects-heading">Projects</Heading>
		<div class="projects-carousel">Lagi gak ada :(</div>
		<div class="projects-display">
			Coba lihat laman GitHub saya untuk melihat apa yang saya sedang
			kerjakan (tautan ada di atas)
		</div>
	</section>
	<footer>
		<a href="https://astro.build/">{Astro.generator}</a>
	</footer>
</Basic>
