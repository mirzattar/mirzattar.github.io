---
import "@css/index.css";
import { LocaleCodes } from "@src/globals";

import Basic from "@l/Basic.astro";
import ThemeToggle from "@c/ThemeToggle.tsx";

const PageName = "Home";
---

<Basic lang={LocaleCodes.EN} PageName={PageName}>
	<main>
		<h1 style="--area: a">Halo</h1>
		<div style="--area: c">
			<p>Currently under construction, please check back later.</p>
			<ThemeToggle client:only="preact" />
		</div>
		<ul style="--area: b">
			<li><a href="https://github.com/mirzattar">github</a></li>
		</ul>
	</main>
	<footer>
		<a href="https://astro.build/">{Astro.generator}</a>
	</footer>
</Basic>
