---
import "@css/index.css";
import ProfilePic from "@img/profile.jpg";
import { LocaleCodes } from "@src/globals";

import Basic from "@l/Basic.astro";
import Heading from "@c/Heading.tsx";
import OptionsMenu from "@c/UIOptionsMenu";
import ProfileCard from "@c/ProfileCard.astro";

const PageName = "Home";
---

<Basic lang={LocaleCodes.EN} PageName={PageName}>
	<OptionsMenu
		themeToggleText="Toggle theme"
		themeRandomText="Randomize theme colors"
		client:only="preact"
	/>
	<main class:list={["hero"]}>
		<Heading level={1} class="hero-heading emphasis">Halo</Heading>
		<div class:list={["hero-content"]}>
			<p>Currently under construction, but feel free to look around.</p>
		</div>
		<ul class:list={["hero-links"]}>
			<li><a href="https://github.com/mirzattar">github</a></li>
		</ul>
	</main>
	<section class="about-me">
		<Heading level={2} class="about-me-heading">About me</Heading>
		<div class="about-me-container">
			<div class="about-me-profile">
				<ProfileCard
					image={ProfilePic}
					name="Mirza Attar Fauzie"
					subtitle="uni student"
					orientation="vertical"
				/>
			</div>
			<div class="about-me-bio">
				<p>Hi, my name is Mirza Attar Fauzie, you can call me Attar.</p>
				<p>
					I am an aspiring software engineer currently enrolled in
					Universitas Indonesia.
				</p>
				<p>
					I mostly dabble in front-end web development, with a
					particular affinity with CSS and JavaScript/TypeScript as
					languages. Among other things, my specialties are:
				</p>
				<ul>
					<li>Writing for legacy codebases or environments.</li>
					<li>
						Collaborating in the community and development of
						open-source projects.
					</li>
					<li>
						Developing systems with new paradigms, methods, and
						technologies (I am excited to learn new things!).
					</li>
					<li>
						Speaking both English and Bahasa Indonesia fluently.
					</li>
					<li>Running and managing cloud deployments, servers, autonomous software, and CI/CD pipelines.</li>
					<li>i use arch, btw.</li>
				</ul>
			</div>
		</div>
	</section>
	<section class="projects">
		<Heading level={2} class="projects-heading">Projects</Heading>
		<div class="projects-carousel">None at the moment :(</div>
		<div class="projects-display">Take a look at my GitHub page to see what I'm currently working on (link at the top)</div>
	</section>
	<footer>
		<a href="https://astro.build/">{Astro.generator}</a>
	</footer>
</Basic>
